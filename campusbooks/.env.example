# ============================================================
# CampusBooks – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.

# --- Local MongoDB (default) ---
# Leave MONGO_URI as-is if you are running MongoDB Community locally.
MONGO_URI=mongodb://localhost:27017

# --- Optional: MongoDB Atlas ---
# Replace the line above with your Atlas connection string, e.g.:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name used throughout the project
DB_NAME=campusbooks
